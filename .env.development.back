 # порт который слушает нест приложение внутри контейнера
PORT=3000
# Имя контейнера базы. В пользовательской docker сети контейнеры находят друг друга по имени
DB_HOST=db
# Порт Постгреса внутри контейнера, по дефолту 5432.
DB_PORT=5432
# Пользователь БД. Должен совпадать с POSTGRES_USER у сервиса db.
DB_USER=todo
# Пароль БД. Должен совпадать с POSTGRES_PASSWORD у контейнера базы.
DB_PASSWORD=todo
# Имя БД. Должно совпадать с POSTGRES_DB у контейнера базы.
DB_NAME=todo
# Адрес, с которого браузер открывает фронт. Разрешаем запросы только с него.
# Порт совпадает с внешним, который проброшен флагом -p при запуске фронта
CORS_ORIGIN=http://localhost:18080
